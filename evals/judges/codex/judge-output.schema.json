{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexImageJudgeResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criteria",
    "annotations",
    "overallAssessment",
    "confidence"
  ],
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "assessability",
          "score",
          "rationale"
        ],
        "properties": {
          "criterionId": {
            "type": "string"
          },
          "assessability": {
            "type": "string",
            "enum": [
              "observable",
              "partially-observable",
              "not-observable"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "x",
          "y",
          "category",
          "severity",
          "note"
        ],
        "properties": {
          "assetRole": {
            "type": "string",
            "enum": [
              "source",
              "output"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "overallAssessment": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
